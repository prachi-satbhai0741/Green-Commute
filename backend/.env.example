PORT=5000
FRONTEND_URL=http://localhost:3000
# For persistent accounts and trips, set a MongoDB connection string:
MONGODB_URI=
# Explicit temporary demo database; first run downloads MongoDB.
DEMO_MODE=true
# Required in production: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
GEOCODER_URL=https://nominatim.openstreetmap.org
ROUTER_URL=https://router.project-osrm.org
